/*
 * Boot Linux from /boot on the USER partition. If that fails, start fastboot
 * with the console back on the screen. A press of the power key before the
 * kernel starts gives fastboot instead of Linux. Once fastboot continues,
 * export the eMMC over USB mass storage.
 */

kernel_addr_r=0x44000000
fdt_addr_r=0x45000000

/* Until fastboot starts, the power key asks for it instead of powering off */
power_key=fastboot

/* What fastboot devices lists, instead of the missing serial number */
set_serial=
	if test "${board_model}" = SM-R381; then
		setenv serial# "Gear 2 Neo";
	else
		setenv serial# "Gear 2";
	fi

/* Keep the screen to the splash, the log goes to serial and the RAM console */
boot_quiet=
	setenv stdin serial;
	setenv stdout serial,ramcon;
	setenv stderr serial,ramcon

boot_user=
	if load mmc 0#user ${kernel_addr_r} /boot/zImage &&
	   load mmc 0#user ${fdt_addr_r} /boot/exynos3250-rinato.dtb; then
		if test "${power_key}" != pressed; then
			bmp display ${booting_splash} m m;
			bootz ${kernel_addr_r} - ${fdt_addr_r};
		fi;
	fi

/*
 * Fastboot and mass storage need the USB gadget, so the USB serial console
 * must let go. A requested fastboot gets its splash, a failed boot the
 * console on the screen. Ignore the power key from here on, pressing it
 * repeatedly to get here would power off again too easily.
 */
boot_fastboot=
	setenv stdin serial;
	if test "${power_key}" = pressed; then
		echo Power key pressed, starting fastboot;
		bmp display ${fastboot_splash} m m;
	else
		setenv stdout serial,vidconsole,ramcon;
		setenv stderr serial,vidconsole,ramcon;
		cls;
		echo Booting from USER failed, starting fastboot;
	fi;
	setenv power_key ignore;
	fastboot usb 0;
	echo Exporting the eMMC as USB mass storage;
	ums 0 mmc 0

bootcmd=run set_serial; run boot_quiet; run boot_user; run boot_fastboot
