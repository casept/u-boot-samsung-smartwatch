/*
 * Boot Linux from /boot on the USER partition. If that fails, start fastboot
 * with the console back on the screen. A press of the power key before the
 * kernel starts, or S-Boot asking for recovery, gives fastboot instead of
 * Linux. Once fastboot continues, export the eMMC over USB mass storage.
 */

kernel_addr_r=0x44000000
fdt_addr_r=0x45000000
fdtoverlay_addr_r=0x45100000

/* Until fastboot starts, the power key asks for it instead of powering off */
power_key=fastboot

/* What fastboot devices lists, instead of the missing serial number */
set_serial=
	if test "${board_model}" = SM-R381; then
		setenv serial# "Gear 2 Neo";
	else
		setenv serial# "Gear 2";
	fi

/* Keep the screen to the splash, the log goes to serial and the RAM console */
boot_quiet=
	setenv stdin serial;
	setenv stdout serial,ramcon;
	setenv stderr serial,ramcon

boot_user=
	if load mmc 0#user ${kernel_addr_r} /boot/zImage &&
	   load mmc 0#user ${fdt_addr_r} /boot/exynos3250-rinato.dtb; then
		run boot_overlays;
		if test "${power_key}" != pressed; then
			bmp display ${booting_splash} m m;
			bootz ${kernel_addr_r} - ${fdt_addr_r};
		fi;
	fi

/* The SM-R380 has the camera the SM-R381 (Neo) lacks */
boot_overlays=
	if test "${board_model}" = SM-R380 &&
	   load mmc 0#user ${fdtoverlay_addr_r} /boot/exynos3250-rinato-r380.dtbo; then
		fdt addr ${fdt_addr_r};
		fdt resize 0x10000;
		fdt apply ${fdtoverlay_addr_r} || run boot_base_dtb;
	fi

/* A failed overlay can leave the tree broken, so start over without it */
boot_base_dtb=
	echo Applying the board overlay failed, booting without it;
	load mmc 0#user ${fdt_addr_r} /boot/exynos3250-rinato.dtb

/*
 * Fastboot and mass storage need the USB gadget, so the USB serial console
 * must let go. Ignore the power key from here on, pressing it repeatedly to
 * get here would power off again too easily.
 */
fastboot_ums=
	setenv stdin serial;
	setenv power_key ignore;
	fastboot usb 0;
	echo Exporting the eMMC as USB mass storage;
	ums 0 mmc 0

/* A requested fastboot gets its splash, a failed boot the console */
boot_fastboot=
	if test "${power_key}" = pressed; then
		echo Power key pressed, starting fastboot;
		bmp display ${fastboot_splash} m m;
	else
		setenv stdout serial,vidconsole,ramcon;
		setenv stderr serial,vidconsole,ramcon;
		cls;
		echo Booting from USER failed, starting fastboot;
	fi;
	run fastboot_ums

/*
 * S-Boot's boot menu and reboot mode 4 ask for recovery, which S-Boot passes
 * on as systemd.unit=recovery-mode.target in its command line. The whole
 * command line matches then and is replaced. No backslashes, the environment
 * import and hush would each strip a level of them.
 */
sboot_recovery=
	setexpr sboot_mode sub '.* systemd.unit=recovery-mode.target.*' recovery
		"${sboot_cmdline}";
	test "${sboot_mode}" = recovery

/*
 * Recovery offers fastboot and mass storage in turns: fastboot continue or a
 * short press of the power key switches to mass storage, ejecting it or a
 * press back to fastboot. A long press powers off.
 */
boot_recovery=
	echo S-Boot asked for recovery;
	setenv stdin serial;
	setenv power_key recovery;
	while true; do
		bmp display ${recovery_fastboot_splash} m m;
		fastboot usb 0;
		bmp display ${recovery_ums_splash} m m;
		ums 0 mmc 0;
	done

bootcmd=
	run set_serial;
	run boot_quiet;
	if run sboot_recovery; then
		run boot_recovery;
	else
		run boot_user;
		run boot_fastboot;
	fi
